{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "habit_tracker_auth",
    "UsersCollectionName": "users"
  },
  "JwtSettings": {
    "Secret": "SUPER_SECRET_KEY_FOR_HABIT_TRACKER_1234567890",
    "Issuer": "HabitTrackerAuthService",
    "Audience": "HabitTrackerClient",
    "ExpiryMinutes": 60
  }
}