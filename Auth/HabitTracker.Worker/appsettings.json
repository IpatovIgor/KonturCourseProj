{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Worker": {
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "LeaseSeconds": 120,
    "LeaseRenewalSeconds": 30,
    "HttpTimeoutSeconds": 10,
    "BootstrapRetrySeconds": 5,
    "ReloadSchedulesOnStartup": false
  },
  "RabbitMq": {
    "VirtualHost": "habit-tracker"
  },
  "WorkerApi": {
    "BaseUrl": "http://localhost:5160"
  }
}
