# Локальная конфигурация Habit Tracker
# Скопируйте файл в .env и заполните секреты локальными значениями.
# При запуске dotnet run передайте настройки в окружение процесса или через
# .NET User Secrets. ASP.NET Core не загружает .env автоматически.

# WebAPI. Для локальной MongoDB используется replica set rs0.
# При включённой аутентификации подставьте URI с учётными данными своего сервиса.
MongoDbSettings__ConnectionString=mongodb://127.0.0.1:27017/?replicaSet=rs0
MongoDbSettings__DatabaseName=habit_tracker_auth
MongoDbSettings__UsersCollectionName=users

# JWT. Задайте случайный ключ длиной не менее 32 байт.
# После добавления Notifications передавайте обоим сервисам одинаковые настройки JWT.
JwtSettings__Secret=
JwtSettings__Issuer=HabitTrackerAuthService
JwtSettings__Audience=HabitTrackerClient
JwtSettings__ExpiryMinutes=60

# React/Vite. Скопируйте эти две переменные в habit-frontend/.env.local
# или передайте их в окружение процесса Vite.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:5160

# Интеграционные тесты. Укажите URI отдельного MongoDB replica set.
KONTUR_TEST_MONGO_URI=

# Планируемые переменные для контейнеров и новых сервисов.
# В Compose и k3s используйте адреса сервисов вместо 127.0.0.1 в URI MongoDB
# и передавайте каждому backend его собственные имя базы и учётные данные.
# ASPNETCORE_HTTP_PORTS=80
# RabbitMq__Host=rabbitmq
# RabbitMq__VirtualHost=habit-tracker
# RabbitMq__Username=
# RabbitMq__Password=
# WorkerApi__BaseUrl=http://webapi:80
# WorkerApi__SharedKey=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Features__NotificationsEnabled=false
